{
    "name": "helsingborg-stad/acf-ux-collapse",
    "description": "Imrpoves the ACF repeater-field UX by adding collapsing top-level functionality",
    "type": "wordpress-plugin",
    "license": "MIT",
    "authors": [
        {
            "name": "Kristoffer Svanmark",
            "email": "kristoffer.svanmark@lexiconitkonsult.se"
        }
    ],
    "require": {
        "helsingborg-stad/wputilservice": "^0.2.44",
        "helsingborg-stad/wpservice": "^2.0"
    },
    "version": "2.0.7",
    "autoload": {
        "psr-4": {
            "AcfUxCollapse\\": "source/php/"
        }
    },
    "require-dev": {
        "phpunit/phpunit": "^11.5",
        "carthage-software/mago": "^0.26.1"
    },
    "scripts": {
        "test": "phpunit --no-coverage --testdox",
        "test:coverage": "XDEBUG_MODE=coverage phpunit --testdox",
        "mago:lint": "vendor/carthage-software/mago/composer/bin/mago lint --fix --format",
        "mago:format": "vendor/carthage-software/mago/composer/bin/mago fmt"
    },
    "config": {
        "allow-plugins": {
            "carthage-software/mago": true
        }
    }
}
